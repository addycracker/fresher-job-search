{
  "maxSources": 1000,
  "pageSize": 100,
  "maxPages": 100,
  "maxJobsPerSource": 20000,
  "requestTimeoutMs": 15000,
  "databaseTimeoutMs": 10000,
  "maxAttempts": 3,
  "retryDelayMs": 500,
