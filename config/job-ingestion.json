  "maxResponseBytes": 10000000,
  "leaseMs": 120000,
  "runTimeoutMs": 840000,
  "providers": {
    "greenhouse": { "url": "https://boards-api.greenhouse.io/v1/boards/{boardToken}/jobs?content=true" },
    "lever": { "url": "https://api.lever.co/v0/postings/{boardToken}?mode=json" },
    "ashby": { "url": "https://api.ashbyhq.com/posting-api/job-board/{boardToken}" }
  }
}
