{
  "name": "fresherjobs-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "seed:companies": "tsx scripts/seed-companies.ts",
    "discover:companies": "tsx apps/company-discovery/src/local.ts",
    "ingest:jobs": "tsx apps/job-ingestion/src/index.ts",
    "build": "tsc",
    "test": "tsx --tsconfig tsconfig.runtime.json --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "api:dev": "tsx watch --tsconfig tsconfig.runtime.json apps/api/src/main.ts",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node dist-api/apps/api/src/main.js",
    "api:typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "api:indexes": "tsx scripts/api-indexes.ts",
    "api:security:setup": "tsx scripts/api-security-setup.ts",
    "web:dev": "npm run dev --workspace @fresherjobs/web",
    "web:build": "npm run build --workspace @fresherjobs/web",
    "web:start": "npm run start --workspace @fresherjobs/web",
    "web:typecheck": "npm run typecheck --workspace @fresherjobs/web",
    "lint": "eslint apps/api/src apps/web/src packages/contracts/src",
    "test:browser": "node tests/browser-smoke.mjs",
    "build:all": "npm run build && npm run api:build && npm run web:build",
    "typecheck:all": "npm run typecheck && npm run api:typecheck && npm run web:typecheck"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.11",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mongoose": "^8.19.0",
    "openai": "^7.58.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
