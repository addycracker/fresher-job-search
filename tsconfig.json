{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@contracts": ["./packages/contracts/src/index.ts"],
      "@transport": ["./packages/contracts/src/transport.ts"],
      "@/*": ["./apps/web/src/*.ts"]
    },
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["apps/web", "apps/api", "node_modules", "dist", "dist-api"]
}
