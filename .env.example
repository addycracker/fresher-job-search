MONGODB_URI=
# Optional comma-separated DNS resolver IP addresses; blank uses system DNS.
DNS_SERVERS=

# Company discovery (local discovery is always dry-run).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_VERSION=v1beta
# Optional alternative; selected only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Model supporting Responses API web search and structured output.
OPENAI_MODEL=gpt-5-mini
DISCOVERY_BATCH_SIZE=10
DISCOVERY_TIMEOUT_MS=240000
DISCOVERY_REQUEST_TIMEOUT_MS=60000
DISCOVERY_DATABASE_TIMEOUT_MS=10000
# Keep disabled until real writes have been approved.
DISCOVERY_ALLOW_WRITES=false

# Job ingestion: reads JobSource records from MongoDB; no LLM required.
INGESTION_MAX_SOURCES=1000
INGESTION_TIMEOUT_MS=840000
INGESTION_DATABASE_TIMEOUT_MS=10000
INGESTION_ALLOW_WRITES=false

# Read-only API. Prefer a separate Atlas database user with the read role.
# If blank/omitted, API falls back to MONGODB_URI.
API_MONGODB_URI=
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
API_SWAGGER_ENABLED=true

# Run npm run api:security:setup for local RSA/AES transport configuration.
API_CLIENT_KEY=
API_PRIVATE_KEY_PATH=
API_RATE_LIMIT=120
API_RATE_WINDOW_MS=60000
# Exact trusted proxy IPs/CIDRs only; blank ignores forwarded client addresses.
API_TRUST_PROXY=
